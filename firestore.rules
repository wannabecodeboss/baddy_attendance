rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins are granted by adding a document at /admins/{uid} from the
    // Firebase console. Nobody can grant it to themselves from the app —
    // writes to /admins are refused below.
    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Formats a timestamp as "YYYY-MM-DD" for comparison against the date
    // strings the app writes.
    function dayString(ts) {
      return string(ts.year()) + "-"
           + (ts.month() < 10 ? "0" : "") + string(ts.month()) + "-"
           + (ts.day() < 10 ? "0" : "") + string(ts.day());
    }

    // Any date from the season opener up to today. The 36-hour forward slack
    // covers teammates in timezones ahead of UTC; it stops well short of
    // letting anyone pre-log next week.
    // Keep the season start in sync with RULES.seasonStart in firebase-config.js.
    function inSeason(dateStr) {
      return dateStr >= "2026-08-31"
          && dateStr <= dayString(request.time + duration.value(36, 'h'));
    }

    function validLog(data, logId) {
      return logId == data.uid + "_" + data.date + "_" + data.activity
             && data.activity in ["run", "badminton"]
             && data.name is string
             && data.uid is string
             && data.date is string
             && data.distanceKm is number
             && data.distanceKm >= 0
             && data.distanceKm <= 200
             // Optional: a teammate on a cached older build sends no time.
             // Validated when present so it can't be junk.
             && (!("durationSec" in data)
                 || (data.durationSec is number
                     && data.durationSec >= 0
                     && data.durationSec <= 86400))
             && inSeason(data.date);
    }

    // The whole team can see the roster. You can only edit your own entry.
    match /members/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.uid == uid;
    }

    // Readable by anyone signed in — the point of the app is that the whole
    // team sees everyone's attendance.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false; // grant admin in the Firebase console only
    }

    // Attendance logs. Doc id is always "{uid}_{date}_{activity}" and must
    // match the data inside, so a log can never be filed under a name that
    // doesn't own it.
    match /logs/{logId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && validLog(request.resource.data, logId)
        && (request.resource.data.uid == request.auth.uid || isAdmin());

      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Nothing else is reachable from the browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
